# Скопируйте этот файл в .env и заполните своими данными.
# .env в репозиторий не попадает.

# Токен бота от @BotFather (например 123456789:AAH...)
TELEGRAM_TOKEN=

# ID чата администратора. Можно оставить пустым:
# python telegram_setup.py --wait 120 сам найдёт и запишет.
TELEGRAM_CHAT_ID=

# Путь к terminal64.exe. Нужен, только если терминал установлен
# в нестандартную папку и бот не находит его сам.
# TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
